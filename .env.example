# Copy to .env and fill in. .env is gitignored: never commit camera passwords.
# Without these the site still runs and shows sample dashboard data.

CAM_HOST=192.168.1.64
CAM_USER=admin
CAM_PASS=your-camera-password
# 101 = main stream, 103 = 720p, 102 = 640x360
CAM_CHANNEL=101
# CAM_RTSP_PORT=554

# Use a file or another stream instead of the camera:
# SOURCE=/path/to/clip.mp4

# Label drawn on every tracked fish
# FISH_LABEL=LMB

# Speeds are reported in px/s until the tank is calibrated; set pixels per cm
# (measure a known length in the camera image) to report cm/s instead.
# PX_PER_CM=0

# What viewers are sent. MJPEG re-sends a whole frame every frame, so these
# three multiply into the bandwidth a remote viewer needs: the defaults below
# measure about 3-4 Mbit/s, against roughly 20 at 1920 and quality 82 uncapped.
# Raise them when everyone watching is on the tank's own network, or ask for
# more on a single stream with ?fps=25.
# OUTPUT_WIDTH=1280
# JPEG_QUALITY=60
# STREAM_FPS=12

# Width the detector works at. This is the main cost of a frame, so lowering it
# is the lever when the tracker cannot keep up (see the fps in /api/vision).
# DETECT_WIDTH=640

# Tracking
# TRACK_MAX_AGE=40
# REID_THRESHOLD=0.15

# Set to 0 to keep the camera's own date/time stamp in the picture
# HIDE_OSD_CLOCK=1

# Set to 1 to never open the camera (used by the tests)
# LIVE_TANK_OFFLINE=0

# --- publishing the tracker -------------------------------------------------
# On the machine running the tracker: callers of /api must send this token
# (header X-Tank-Token, or ?t=). Set it whenever the machine is reachable
# from outside your network, e.g. through a tunnel.
# LIVE_TANK_TOKEN=a-long-random-string

# On the public site (Vercel, Render), which has no camera of its own:
# where the tracker lives and the token to reach it. Set these in the host's
# environment, not in a committed file.
# TRACKER_ORIGIN=https://tank.example.com
# TRACKER_TOKEN=the-same-long-random-string
